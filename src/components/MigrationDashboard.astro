  { year: '2017', count: 1200000, label: '1.2M' },
  { year: '2018', count: 2000000, label: '2.0M' },
  { year: '2019', count: 3200000, label: '3.2M' },
  { year: '2020', count: 4000000, label: '4.0M' },
  { year: '2021', count: 4800000, label: '4.8M' },
  { year: '2022', count: 5500000, label: '5.5M' },
  { year: '2023', count: 6200000, label: '6.2M' },
  { year: '2024', count: 6800000, label: '6.8M' },
  { year: '2025', count: 6911757, label: '6.9M' }
];

const colombiaEvolution = [
  { year: '2015', count: 30000 },
  { year: '2016', count: 50000 },
  { year: '2017', count: 200000 },
  { year: '2018', count: 550000 },
  { year: '2019', count: 1200000 },
  { year: '2020', count: 1700000 },
  { year: '2021', count: 1950000 },
  { year: '2022', count: 2500000 },
  { year: '2023', count: 2650000 },
  { year: '2024', count: 2800000 },
  { year: '2025', count: 2828195 }
