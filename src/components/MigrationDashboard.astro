---
// Componente de Mapa de Migración Venezolana - CON MAPA REAL
const migrationData = {
  countries: [
    { name: 'Colombia', count: 2828195, percent: 40.9, color: '#6a040f', code: 'COL' },
    { name: 'Perú', count: 1662889, percent: 24.0, color: '#9d0208', code: 'PER' },
    { name: 'Brasil', count: 732272, percent: 10.6, color: '#d00000', code: 'BRA' },
    { name: 'Chile', count: 669408, percent: 9.7, color: '#e85d04', code: 'CHL' },
    { name: 'Ecuador', count: 440450, percent: 6.4, color: '#f48c06', code: 'ECU' },
    { name: 'Argentina', count: 174796, percent: 2.5, color: '#3d0066', code: 'ARG' },
    { name: 'México', count: 106015, percent: 1.5, color: '#ffba08', code: 'MEX' },
    { name: 'Rep. Dominicana', count: 99692, percent: 1.4, color: '#faa307', code: 'DOM' },
    { name: 'Otros', count: 195240, percent: 2.8, color: '#5a189a', code: 'OTR' }
  ],
  total: 6911757
};

const evolutionData = [
  { year: '2015', count: 700000, label: '700K' },
  { year: '2017', count: 1200000, label: '1.2M' },
  { year: '2018', count: 2000000, label: '2.0M' },
  { year: '2019', count: 3200000, label: '3.2M' },
  { year: '2020', count: 4000000, label: '4.0M' },
  { year: '2021', count: 4800000, label: '4.8M' },
  { year: '2022', count: 5500000, label: '5.5M' },
  { year: '2023', count: 6200000, label: '6.2M' },
  { year: '2024', count: 6800000, label: '6.8M' },
  { year: '2025', count: 6911757, label: '6.9M' }
];

const colombiaEvolution = [
  { year: '2015', count: 30000 },
  { year: '2016', count: 50000 },
  { year: '2017', count: 200000 },
  { year: '2018', count: 550000 },
  { year: '2019', count: 1200000 },
  { year: '2020', count: 1700000 },
  { year: '2021', count: 1950000 },
  { year: '2022', count: 2500000 },
  { year: '2023', count: 2650000 },
  { year: '2024', count: 2800000 },
  { year: '2025', count: 2828195 }
];
---

<div class="migration-dashboard">
  
  <!-- Resumen General -->
  <div class="bg-gradient-to-br from-[#6a040f] to-[#370617] rounded-2xl p-8 mb-8 text-white shadow-2xl relative overflow-hidden" data-aos="fade-up">
    <!-- Decoración de fondo -->
    <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/2"></div>
    <div class="absolute bottom-0 left-0 w-48 h-48 bg-[#ffba08]/10 rounded-full translate-y-1/2 -translate-x-1/2"></div>
    
    <div class="relative z-10">
      <h3 class="text-2xl font-bold mb-2">Crisis Migratoria Venezolana</h3>
      <p class="text-white/80 mb-6">La mayor crisis de desplazamiento en la historia reciente de América Latina</p>
      
      <div class="grid md:grid-cols-3 gap-6">
        <div 
          class="bg-white/10 backdrop-blur rounded-xl p-4 text-center transform hover:scale-105 hover:bg-white/20 transition-all duration-300 cursor-pointer group"
          data-aos="zoom-in" data-aos-delay="0"
        >
          <div class="text-4xl font-bold text-[#ffba08] counter" data-target="7910000">0</div>
          <p class="text-sm text-white/70">Total migrantes en el mundo</p>
          <div class="mt-2 text-xs text-[#ffba08] opacity-0 group-hover:opacity-100 transition-opacity">↑ 7.9 millones</div>
        </div>
        
        <div 
          class="bg-white/10 backdrop-blur rounded-xl p-4 text-center transform hover:scale-105 hover:bg-white/20 transition-all duration-300 cursor-pointer group"
          data-aos="zoom-in" data-aos-delay="100"
        >
          <div class="text-4xl font-bold text-[#ffba08] counter" data-target="6911757">0</div>
          <p class="text-sm text-white/70">En América Latina y el Caribe</p>
          <div class="mt-2 text-xs text-[#ffba08] opacity-0 group-hover:opacity-100 transition-opacity">↑ 6.9 millones</div>
        </div>
        
        <div 
          class="bg-white/10 backdrop-blur rounded-xl p-4 text-center transform hover:scale-105 hover:bg-white/20 transition-all duration-300 cursor-pointer group"
          data-aos="zoom-in" data-aos-delay="200"
        >
          <div class="text-4xl font-bold text-[#ffba08]">17</div>
          <p class="text-sm text-white/70">Países de la Plataforma R4V</p>
          <div class="mt-2 text-xs text-[#ffba08] opacity-0 group-hover:opacity-100 transition-opacity">ACNUR / OIM</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mapa Mundial (Placeholder - usuario diseñará el mapa) -->
  <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 mb-8 shadow-lg border border-gray-100 dark:border-gray-700" data-aos="fade-up" data-aos-delay="100">
    <h4 class="text-xl font-bold text-[#6a040f] dark:text-[#ffba08] mb-2 flex items-center gap-2">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      Mapa Mundial de Distribución Migratoria
    </h4>
    <p class="text-gray-600 dark:text-gray-400 mb-6 text-sm">
      Flujo de migrantes venezolanos hacia los principales países de acogida (2025)
    </p>

    <!-- PLACEHOLDER PARA MAPA - Aquí irá el diseño del usuario -->
    <div class="relative bg-gradient-to-br from-slate-100 to-slate-200 dark:from-slate-800 dark:to-slate-900 rounded-xl overflow-hidden flex items-center justify-center" style="min-height: 400px;">
      <div class="text-center p-8">
        <div class="w-24 h-24 mx-auto mb-4 rounded-full bg-gradient-to-br from-[#6a040f] to-[#ffba08] flex items-center justify-center">
          <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <h5 class="text-lg font-bold text-gray-700 dark:text-gray-300 mb-2">Mapa en Diseño</h5>
        <p class="text-gray-500 dark:text-gray-400 text-sm max-w-md">
          El mapa mundial con la distribución migratoria está siendo diseñado. 
          Pronto se mostrará aquí con todas las rutas y destinos.
        </p>
        
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <span class="px-3 py-1 bg-[#6a040f]/10 dark:bg-[#ffba08]/20 text-[#6a040f] dark:text-[#ffba08] rounded-full text-xs font-medium">Colombia 2.8M</span>
          <span class="px-3 py-1 bg-[#9d0208]/10 dark:bg-[#ffba08]/20 text-[#9d0208] dark:text-[#ffba08] rounded-full text-xs font-medium">Perú 1.7M</span>
          <span class="px-3 py-1 bg-[#d00000]/10 dark:bg-[#ffba08]/20 text-[#d00000] dark:text-[#ffba08] rounded-full text-xs font-medium">Brasil 732K</span>
          <span class="px-3 py-1 bg-[#e85d04]/10 dark:bg-[#ffba08]/20 text-[#e85d04] dark:text-[#ffba08] rounded-full text-xs font-medium">Chile 669K</span>
          <span class="px-3 py-1 bg-[#f48c06]/10 dark:bg-[#ffba08]/20 text-[#f48c06] dark:text-[#ffba08] rounded-full text-xs font-medium">Ecuador 440K</span>
        </div>
      </div>
    </div>

    <!-- Barras de distribución -->
    <div class="mt-8 space-y-3">
      <h5 class="text-sm font-semibold text-gray-600 dark:text-gray-400 mb-4">Distribución detallada por país</h5>
      {migrationData.countries.map((country, index) => (
        <div 
          class="migration-bar-container group cursor-pointer" 
          data-aos="fade-right" 
          data-aos-delay={index * 50}
        >
          <div class="flex justify-between items-center mb-1">
            <span class="font-medium text-gray-700 dark:text-gray-300 text-sm group-hover:text-[#6a040f] dark:group-hover:text-[#ffba08] transition-colors">{country.name}</span>
            <span class="text-sm text-gray-500 dark:text-gray-400">
              <span class="font-bold text-[#6a040f] dark:text-[#ffba08]">{country.count.toLocaleString()}</span>
              <span class="ml-1">({country.percent}%)</span>
            </span>
          </div>
          <div class="h-3 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
            <div 
              class="h-full rounded-full transition-all duration-1000 ease-out migration-bar group-hover:brightness-125"
              style={`width: 0%; background: linear-gradient(90deg, ${country.color}, ${country.color}dd);`}
              data-width={`${country.percent}%`}
              data-delay={index * 100}
            />
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Evolución Temporal -->
  <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 mb-8 shadow-lg hover:shadow-2xl transition-all duration-500 border border-gray-100 dark:border-gray-700" data-aos="fade-up" data-aos-delay="150">
    <h4 class="text-xl font-bold text-[#6a040f] dark:text-[#ffba08] mb-4 flex items-center gap-2">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
      </svg>
      Evolución del Éxodo Venezolano (2015-2025)
    </h4>
    <p class="text-gray-600 dark:text-gray-400 mb-6 text-sm">
      Crecimiento acumulado de migrantes y refugiados en la región - de 700K a 6.9 millones
    </p>

    <!-- Línea de Tiempo Horizontal -->
    <div class="relative">
      <div class="flex items-end justify-between h-48 md:h-64 gap-2">
        {evolutionData.map((item, index) => (
          <div 
            class="flex-1 flex flex-col items-center group cursor-pointer" 
            data-aos="fade-up" 
            data-aos-delay={index * 80}
          >
            <div class="text-xs text-gray-500 dark:text-gray-400 mb-1 opacity-0 group-hover:opacity-100 transition-opacity font-semibold bg-[#6a040f]/10 dark:bg-[#ffba08]/20 px-2 py-1 rounded">
              {item.label}
            </div>
            <div 
              class="w-full bg-gradient-to-t from-[#6a040f] to-[#ffba08] rounded-t-md transition-all duration-500 evolution-bar group-hover:brightness-110 relative overflow-hidden"
              style={`height: 0%;`}
              data-height={`${(item.count / 8000000) * 100}%`}
              data-delay={index * 100}
            >
              <div class="absolute inset-0 bg-white/20 animate-pulse opacity-0 group-hover:opacity-100 transition-opacity"></div>
            </div>
            <div class="text-xs text-gray-600 dark:text-gray-400 mt-2 font-medium group-hover:text-[#6a040f] dark:group-hover:text-[#ffba08] transition-colors bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded-full group-hover:bg-[#6a040f]/10 dark:group-hover:bg-[#ffba08]/20">{item.year}</div>
          </div>
        ))}
      </div>
      
      <!-- Línea base -->
      <div class="absolute bottom-8 left-0 right-0 h-0.5 bg-gradient-to-r from-[#6a040f] via-[#ffba08] to-[#6a040f]" />
    </div>

    <div class="mt-4 text-center text-sm text-gray-500 dark:text-gray-400">
      Fuente: Plataforma R4V, ACNUR, OIM - Noviembre 2025
    </div>
  </div>

  <!-- Colombia: Evolución Específica -->
  <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-lg hover:shadow-2xl transition-all duration-500 border border-gray-100 dark:border-gray-700" data-aos="fade-up" data-aos-delay="200">
    <h4 class="text-xl font-bold text-[#6a040f] dark:text-[#ffba08] mb-4 flex items-center gap-2">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
      </svg>
      Migración Venezuela → Colombia (Evolución Anual)
    </h4>
    <p class="text-gray-600 dark:text-gray-400 mb-6 text-sm">
      Colombia es el principal país de acogida con el 41% del total migratorio (2.8 millones)
    </p>

    <!-- Gráfico de Área -->
    <div class="relative h-64">
      <svg viewBox="0 0 600 200" class="w-full h-full" preserveAspectRatio="none">
        <defs>
          <linearGradient id="areaGradient" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" style="stop-color:#6a040f;stop-opacity:0.8" />
            <stop offset="100%" style="stop-color:#6a040f;stop-opacity:0.1" />
          </linearGradient>
        </defs>
        
        <!-- Área -->
        <path 
          class="area-path"
          fill="url(#areaGradient)"
          d="M 0,200 L 0,200 L 55,200 L 110,200 L 165,200 L 220,200 L 275,200 L 330,200 L 385,200 L 440,200 L 495,200 L 550,200 L 600,200 Z"
          data-points="M 0,192 L 55,191 L 110,178 L 165,140 L 220,91 L 275,65 L 330,49 L 385,28 L 440,23 L 495,15 L 550,11 L 600,10"
        />
        
        <!-- Línea -->
        <path 
          class="line-path"
          fill="none"
          stroke="#6a040f"
          stroke-width="3"
          d="M 0,192 L 55,191 L 110,178 L 165,140 L 220,91 L 275,65 L 330,49 L 385,28 L 440,23 L 495,15 L 550,11 L 600,10"
          stroke-dasharray="1000"
          stroke-dashoffset="1000"
        />
        
        <!-- Puntos interactivos -->
        {colombiaEvolution.map((item, index) => {
          const x = index * 55;
          const y = 200 - ((item.count / 3000000) * 190);
          return (
            <g class="data-point-group cursor-pointer">
              <circle cx={x} cy={y} r="6" fill="#ffba08" stroke="#6a040f" stroke-width="2" class="transition-all duration-300 hover:r-10" opacity="0">
                <animate attributeName="opacity" values="0;1" dur="0.3s" begin={`${2 + index * 0.1}s`} fill="freeze" />
              </circle>
              <title>{item.year}: {item.count.toLocaleString()} migrantes</title>
            </g>
          );
        })}
      </svg>
      
      <!-- Etiquetas del eje Y -->
      <div class="absolute left-0 top-0 bottom-0 flex flex-col justify-between text-xs text-gray-400 -ml-8">
        <span>3M</span>
        <span>2M</span>
        <span>1M</span>
        <span>0</span>
      </div>
    </div>

    <!-- Leyenda -->
    <div class="flex justify-between items-center mt-4 text-sm text-gray-500 dark:text-gray-400">
      <span>2015</span>
      <span class="text-[#6a040f] dark:text-[#ffba08] font-semibold bg-gradient-to-r from-[#6a040f]/10 to-[#ffba08]/10 dark:from-[#ffba08]/20 dark:to-[#6a040f]/20 px-4 py-2 rounded-full shadow-sm">2.8 millones en 2025</span>
      <span>2025</span>
    </div>
  </div>

  <!-- Fuentes -->
  <div class="mt-8 p-4 bg-gray-100 dark:bg-gray-900 rounded-xl text-sm border border-gray-200 dark:border-gray-700" data-aos="fade-up" data-aos-delay="250">
    <h5 class="font-semibold text-gray-700 dark:text-gray-300 mb-2 flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      Fuentes de Información:
    </h5>
    <ul class="space-y-1 text-gray-600 dark:text-gray-400">
      <li>• <strong>Plataforma R4V</strong> (ACNUR/OIM) - Noviembre 2025: 6.9 millones en ALC</li>
      <li>• <strong>ACNUR</strong> - Tendencias Globales 2024: Mayor crisis de desplazamiento mundial</li>
      <li>• <strong>DANE Colombia</strong> - Estadísticas migratorias</li>
      <li>• <strong>OIM</strong> - Reportes de movimientos trimestrales 2024-2025</li>
      <li>• <strong>Bloomberg Línea</strong> - Reportes diarios de crisis migratoria</li>
    </ul>
    <p class="mt-3 text-xs text-gray-500">
      <em>Nota: Estas cifras son estimaciones oficiales de los gobiernos de acogida y pueden incluir un grado de estimación según la metodología de cada país. Datos actualizados a noviembre 2025.</em>
    </p>
  </div>
</div>

<style>
  .migration-bar {
    transition: width 1s ease-out;
  }
  
  .evolution-bar {
    transition: height 0.8s ease-out;
  }
  
  .line-path {
    animation: drawLine 2s ease-out forwards;
  }
  
  @keyframes drawLine {
    to {
      stroke-dashoffset: 0;
    }
  }
  
  .data-point {
    animation: fadeIn 0.3s ease-out forwards;
    animation-delay: 2s;
  }
  
  @keyframes fadeIn {
    to {
      opacity: 1;
    }
  }
  
  .counter {
    font-variant-numeric: tabular-nums;
  }
  
  /* Efectos hover para nodos de países */
  .country-marker {
    cursor: pointer;
    transition: all 0.3s ease;
  }
  
  .country-marker:hover .marker-circle {
    filter: drop-shadow(0 0 15px rgba(255, 186, 8, 0.9));
    stroke-width: 4px;
    animation: marker-pulse 0.8s ease infinite alternate;
  }
  
  @keyframes marker-pulse {
    from { transform: scale(1); }
    to { transform: scale(1.12); }
  }
  
  .country-marker:hover .percent-label {
    opacity: 1 !important;
  }
  
  /* Líneas de flujo */
  .flow-line {
    animation: flow-move 1s linear infinite;
  }
  
  @keyframes flow-move {
    to {
      stroke-dashoffset: -15;
    }
  }
</style>

<script>
  // Animación de barras de migración
  function animateMigrationBars() {
    const bars = document.querySelectorAll('.migration-bar');
    bars.forEach(bar => {
      const width = bar.getAttribute('data-width');
      const delay = parseInt(bar.getAttribute('data-delay') || '0');
      setTimeout(() => {
        bar.style.width = width;
      }, delay);
    });
  }

  // Animación de barras de evolución
  function animateEvolutionBars() {
    const bars = document.querySelectorAll('.evolution-bar');
    bars.forEach(bar => {
      const height = bar.getAttribute('data-height');
      const delay = parseInt(bar.getAttribute('data-delay') || '0');
      setTimeout(() => {
        bar.style.height = height;
      }, delay);
    });
  }

  // Animación de contadores
  function animateCounters() {
    const counters = document.querySelectorAll('.counter');
    counters.forEach(counter => {
      const target = parseInt(counter.getAttribute('data-target'));
      const duration = 2000;
      const increment = target / (duration / 16);
      let current = 0;
      
      const updateCounter = () => {
        current += increment;
        if (current < target) {
          counter.textContent = Math.floor(current).toLocaleString();
          requestAnimationFrame(updateCounter);
        } else {
          counter.textContent = target.toLocaleString();
        }
      };
      
      updateCounter();
    });
  }

  // Animación del área de Colombia
  function animateAreaChart() {
    const areaPath = document.querySelector('.area-path');
    if (areaPath) {
      const finalPoints = areaPath.getAttribute('data-points');
      setTimeout(() => {
        areaPath.setAttribute('d', `${finalPoints} L 600,200 Z`);
      }, 500);
    }
  }

  // Iniciar animaciones cuando el componente es visible
  if (typeof window !== 'undefined') {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          animateMigrationBars();
          animateEvolutionBars();
          animateCounters();
          animateAreaChart();
          observer.disconnect();
        }
      });
    }, { threshold: 0.1 });

    const dashboard = document.querySelector('.migration-dashboard');
    if (dashboard) {
      observer.observe(dashboard);
    }
  }
</script>
