// Coordenadas aproximadas para el mapa
const worldMapData = {
  venezuela: { x: 280, y: 220, r: 12 },
  colombia: { x: 260, y: 235, r: 18, count: '2.8M' },
  peru: { x: 230, y: 280, r: 15, count: '1.7M' },
  brasil: { x: 320, y: 300, r: 14, count: '732K' },
  chile: { x: 240, y: 350, r: 13, count: '669K' },
  ecuador: { x: 235, y: 250, r: 12, count: '440K' },
  argentina: { x: 270, y: 380, r: 11, count: '175K' },
  mexico: { x: 150, y: 180, r: 10, count: '106K' },
  dominicana: { x: 310, y: 190, r: 9, count: '100K' },
  usa: { x: 180, y: 150, r: 10, count: '100K' },
  panama: { x: 265, y: 215, r: 8, count: '80K' }
};
---

<div class="migration-dashboard">
  
  <!-- Resumen General -->
  <div class="bg-gradient-to-br from-[#6a040f] to-[#370617] rounded-2xl p-8 mb-8 text-white shadow-2xl relative overflow-hidden" data-aos="fade-up">
    <!-- Decoración de fondo -->
    <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/2"></div>
    <div class="absolute bottom-0 left-0 w-48 h-48 bg-[#ffba08]/10 rounded-full translate-y-1/2 -translate-x-1/2"></div>
    
    <div class="relative z-10">
      <h3 class="text-2xl font-bold mb-2">Crisis Migratoria Venezolana</h3>
      <p class="text-white/80 mb-6">La mayor crisis de desplazamiento en la historia reciente de América Latina</p>
      
      <div class="grid md:grid-cols-3 gap-6">
        <div 
          class="bg-white/10 backdrop-blur rounded-xl p-4 text-center transform hover:scale-105 hover:bg-white/20 transition-all duration-300 cursor-pointer group"
          data-aos="zoom-in" data-aos-delay="0"
        >
          <div class="text-4xl font-bold text-[#ffba08] counter" data-target="7910000">0</div>
          <p class="text-sm text-white/70">Total migrantes en el mundo</p>
          <div class="mt-2 text-xs text-[#ffba08] opacity-0 group-hover:opacity-100 transition-opacity">↑ 7.9 millones</div>
        </div>
        
        <div 
          class="bg-white/10 backdrop-blur rounded-xl p-4 text-center transform hover:scale-105 hover:bg-white/20 transition-all duration-300 cursor-pointer group"
          data-aos="zoom-in" data-aos-delay="100"
        >
          <div class="text-4xl font-bold text-[#ffba08] counter" data-target="6911757">0</div>
          <p class="text-sm text-white/70">En América Latina y el Caribe</p>
          <div class="mt-2 text-xs text-[#ffba08] opacity-0 group-hover:opacity-100 transition-opacity">↑ 6.9 millones</div>
        </div>
        
        <div 
          class="bg-white/10 backdrop-blur rounded-xl p-4 text-center transform hover:scale-105 hover:bg-white/20 transition-all duration-300 cursor-pointer group"
          data-aos="zoom-in" data-aos-delay="200"
        >
          <div class="text-4xl font-bold text-[#ffba08]">17</div>
          <p class="text-sm text-white/70">Países de la Plataforma R4V</p>
          <div class="mt-2 text-xs text-[#ffba08] opacity-0 group-hover:opacity-100 transition-opacity">ACNUR / OIM</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mapa Mundial de Distribución -->
  <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 mb-8 shadow-lg hover:shadow-2xl transition-all duration-500 border border-gray-100 dark:border-gray-700" data-aos="fade-up" data-aos-delay="100">
    <h4 class="text-xl font-bold text-[#6a040f] dark:text-[#ffba08] mb-2 flex items-center gap-2">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      Mapa Mundial de Distribución Migratoria
    </h4>
    <p class="text-gray-600 dark:text-gray-400 mb-6 text-sm">
      Flujo de migrantes venezolanos hacia los principales países de acogida (2025)
    </p>

    <!-- Mapa Mundial Real -->
    <div class="relative bg-gradient-to-b from-sky-50 to-blue-100 dark:from-slate-900 dark:to-slate-800 rounded-xl overflow-hidden" style="min-height: 450px;">
      <svg viewBox="0 0 800 400" class="w-full h-full" preserveAspectRatio="xMidYMid meet">
        <defs>
          <!-- Gradientes para países destino -->
          <linearGradient id="grad-colombia" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#6a040f"/>
            <stop offset="100%" stop-color="#9d0208"/>
          </linearGradient>
          <linearGradient id="grad-peru" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#9d0208"/>
            <stop offset="100%" stop-color="#d00000"/>
          </linearGradient>
          <linearGradient id="grad-brasil" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#d00000"/>
            <stop offset="100%" stop-color="#e85d04"/>
          </linearGradient>
          <linearGradient id="grad-chile" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#e85d04"/>
            <stop offset="100%" stop-color="#f48c06"/>
          </linearGradient>
          <linearGradient id="grad-ecuador" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#f48c06"/>
            <stop offset="100%" stop-color="#ffba08"/>
          </linearGradient>
          
          <!-- Filtro de brillo dorado -->
          <filter id="glow-gold" x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur stdDeviation="4" result="coloredBlur"/>
            <feMerge>
              <feMergeNode in="coloredBlur"/>
              <feMergeNode in="coloredBlur"/>
              <feMergeNode in="SourceGraphic"/>
            </feMerge>
          </filter>
          
          <!-- Gradiente de pulso -->
          <radialGradient id="pulse-grad">
            <stop offset="0%" stop-color="#ffba08" stop-opacity="0.8"/>
            <stop offset="50%" stop-color="#ffba08" stop-opacity="0.3"/>
            <stop offset="100%" stop-color="#ffba08" stop-opacity="0"/>
          </radialGradient>
          
          <!-- Gradiente para fondo de mapa -->
          <linearGradient id="ocean-grad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#0ea5e9" stop-opacity="0.1"/>
            <stop offset="100%" stop-color="#0284c7" stop-opacity="0.2"/>
          </linearGradient>
        </defs>
        
        <!-- Fondo océano -->
        <rect width="800" height="400" fill="url(#ocean-grad)"/>
        
        <!-- MAPA MUNDIAL - Siluetas de continentes (simplificado pero real) -->
        <g class="continents" opacity="0.15">
          <!-- América del Norte -->
          <path d="M60,80 
                   Q80,70 120,65 L180,60 Q220,55 250,70 
                   L280,85 Q300,90 290,110 L280,130 
                   Q270,150 260,170 L240,180
                   Q220,185 200,175 L180,165
                   Q160,155 140,160 L100,150
                   Q70,140 60,120 L50,100 Z" 
                fill="#64748b"/>
          
          <!-- Centroamérica y Caribe -->
          <path d="M240,180 
                   L260,200 L270,220 
                   L265,240 L255,250
                   L245,245 L235,230
                   L230,210 L235,195 Z" 
                fill="#64748b"/>
          
          <!-- América del Sur -->
          <path d="M255,250
                   L285,255 L310,265 L330,280
                   L340,300 L335,330
                   L320,360 L300,380
                   L280,385 L260,375
                   L245,350 L240,320
                   L235,290 L240,270 Z" 
                fill="#64748b"/>
          
          <!-- Europa -->
          <path d="M380,80 
                   L420,75 L460,70 L490,75
                   L510,85 L520,100
                   L515,115 L500,125
                   L480,130 L460,125
                   L440,120 L420,115
                   L400,110 L385,100 Z" 
                fill="#64748b"/>
          
          <!-- África -->
          <path d="M400,130
                   L440,125 L480,130 L500,145
                   L510,170 L505,210
                   L490,260 L470,300
                   L450,320 L430,315
                   L415,300 L410,270
                   L405,230 L400,190
                   L395,160 Z" 
                fill="#64748b"/>
          
          <!-- Asia -->
          <path d="M520,80
                   L560,70 L620,65 L680,70
                   L720,80 L750,100
                   L760,130 L755,160
                   L740,180 L710,190
                   L680,185 L650,170
                   L620,160 L590,150
                   L560,140 L540,125
                   L525,105 Z" 
                fill="#64748b"/>
          
          <!-- Oceanía -->
          <path d="M680,280
                   L720,275 L750,280 L760,300
                   L755,320 L730,325
                   L700,320 L685,310
                   L675,295 Z" 
                fill="#64748b"/>
        </g>
        
        <!-- Grilla de latitud/longitud sutil -->
        <g class="grid" stroke="#64748b" stroke-width="0.5" opacity="0.1">
          <line x1="0" y1="100" x2="800" y2="100"/>
          <line x1="0" y1="200" x2="800" y2="200"/>
          <line x1="0" y1="300" x2="800" y2="300"/>
          <line x1="200" y1="0" x2="200" y2="400"/>
          <line x1="400" y1="0" x2="400" y2="400"/>
          <line x1="600" y1="0" x2="600" y2="400"/>
        </g>
        
        <!-- LÍNEAS DE FLUJO MIGRATORIO desde Venezuela -->
        <g class="flow-lines">
          <!-- Venezuela a Colombia -->
          <path class="flow-line" d="M278,255 Q268,262 258,268" 
                stroke="url(#grad-colombia)" stroke-width="4" fill="none" stroke-linecap="round" opacity="0.8">
            <animate attributeName="stroke-dasharray" values="0,100;100,0" dur="1.2s" repeatCount="indefinite"/>
            <animate attributeName="opacity" values="0.8;0.4;0.8" dur="2s" repeatCount="indefinite"/>
          </path>
          
          <!-- Venezuela a Perú -->
          <path class="flow-line" d="M275,260 Q250,285 235,305" 
                stroke="url(#grad-peru)" stroke-width="3" fill="none" stroke-linecap="round" opacity="0.7">
            <animate attributeName="stroke-dasharray" values="0,100;100,0" dur="1.5s" repeatCount="indefinite"/>
            <animate attributeName="opacity" values="0.7;0.3;0.7" dur="2.2s" repeatCount="indefinite"/>
          </path>
          
          <!-- Venezuela a Brasil -->
          <path class="flow-line" d="M285,265 Q305,290 320,315" 
                stroke="url(#grad-brasil)" stroke-width="2.5" fill="none" stroke-linecap="round" opacity="0.6">
            <animate attributeName="stroke-dasharray" values="0,100;100,0" dur="1.8s" repeatCount="indefinite"/>
          </path>
          
          <!-- Venezuela a Chile -->
          <path class="flow-line" d="M275,270 Q260,315 245,355" 
                stroke="url(#grad-chile)" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.6">
            <animate attributeName="stroke-dasharray" values="0,100;100,0" dur="2s" repeatCount="indefinite"/>
          </path>
          
          <!-- Venezuela a Ecuador -->
          <path class="flow-line" d="M270,258 Q255,265 240,272" 
                stroke="url(#grad-ecuador)" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.5">
            <animate attributeName="stroke-dasharray" values="0,100;100,0" dur="1.4s" repeatCount="indefinite"/>
          </path>
          
          <!-- Venezuela a Argentina -->
          <path class="flow-line" d="M280,275 Q275,325 270,375" 
                stroke="#3d0066" stroke-width="1.5" fill="none" stroke-linecap="round" opacity="0.5">
            <animate attributeName="stroke-dasharray" values="0,100;100,0" dur="2.5s" repeatCount="indefinite"/>
          </path>
          
          <!-- Venezuela a México -->
          <path class="flow-line" d="M268,245 Q220,210 175,175" 
                stroke="#ffba08" stroke-width="1.5" fill="none" stroke-linecap="round" opacity="0.4">
            <animate attributeName="stroke-dasharray" values="0,100;100,0" dur="3s" repeatCount="indefinite"/>
          </path>
          
          <!-- Venezuela a USA -->
          <path class="flow-line" d="M272,240 Q230,195 185,155" 
                stroke="#faa307" stroke-width="1.5" fill="none" stroke-linecap="round" opacity="0.4">
            <animate attributeName="stroke-dasharray" values="0,100;100,0" dur="3.2s" repeatCount="indefinite"/>
          </path>
          
          <!-- Venezuela a España -->
          <path class="flow-line" d="M285,235 Q350,180 420,120" 
                stroke="#6a040f" stroke-width="1" fill="none" stroke-linecap="round" opacity="0.3">
            <animate attributeName="stroke-dasharray" values="0,100;100,0" dur="4s" repeatCount="indefinite"/>
          </path>
        </g>
        
        <!-- CÍRCULOS DE PULSO en destinos principales -->
        <g class="pulse-circles">
          <!-- Colombia - Principal destino -->
          <circle cx="258" cy="268" r="35" fill="url(#pulse-grad)" opacity="0.6">
            <animate attributeName="r" values="20;40;20" dur="2s" repeatCount="indefinite"/>
            <animate attributeName="opacity" values="0.6;0;0.6" dur="2s" repeatCount="indefinite"/>
          </circle>
          
          <!-- Perú -->
          <circle cx="235" cy="305" r="28" fill="url(#pulse-grad)" opacity="0.5">
            <animate attributeName="r" values="15;30;15" dur="2.3s" repeatCount="indefinite"/>
            <animate attributeName="opacity" values="0.5;0;0.5" dur="2.3s" repeatCount="indefinite"/>
          </circle>
          
          <!-- Brasil -->
          <circle cx="320" cy="315" r="25" fill="url(#pulse-grad)" opacity="0.4">
            <animate attributeName="r" values="14;28;14" dur="2.5s" repeatCount="indefinite"/>
            <animate attributeName="opacity" values="0.4;0;0.4" dur="2.5s" repeatCount="indefinite"/>
          </circle>
        </g>
        
        <!-- VENEZUELA - Origen (círculo pulsante central) -->
        <g class="origin-country cursor-pointer">
          <circle cx="278" cy="255" r="18" fill="#370617" stroke="#ffba08" stroke-width="4" filter="url(#glow-gold)">
            <animate attributeName="r" values="16;20;16" dur="1.5s" repeatCount="indefinite"/>
            <animate attributeName="stroke-width" values="3;5;3" dur="1.5s" repeatCount="indefinite"/>
          </circle>
          <text x="278" y="260" text-anchor="middle" fill="#ffba08" font-size="9" font-weight="bold">VEN</text>
          <text x="278" y="235" text-anchor="middle" fill="#370617" font-size="8" font-weight="bold" class="dark:fill-white">ORIGEN</text>
        </g>
        
        <!-- PAÍSES DESTINO con círculos proporcionales -->
        <g class="destination-countries">
          <!-- Colombia - Mayor destino (2.8M) -->
          <g class="country-node cursor-pointer" data-country="Colombia" data-count="2828195">
            <circle cx="258" cy="268" r="22" fill="url(#grad-colombia)" stroke="white" stroke-width="3" class="hover-effect"/>
            <text x="258" y="263" text-anchor="middle" fill="white" font-size="9" font-weight="bold">Colombia</text>
            <text x="258" y="275" text-anchor="middle" fill="#ffba08" font-size="12" font-weight="bold">2.8M</text>
            <text x="258" y="305" text-anchor="middle" fill="#6a040f" font-size="11" font-weight="bold" opacity="0" class="percentage-label dark:fill-white">40.9%</text>
          </g>
          
          <!-- Perú (1.7M) -->
          <g class="country-node cursor-pointer" data-country="Perú" data-count="1662889">
            <circle cx="235" cy="305" r="18" fill="url(#grad-peru)" stroke="white" stroke-width="3" class="hover-effect"/>
            <text x="235" y="300" text-anchor="middle" fill="white" font-size="8" font-weight="bold">Perú</text>
            <text x="235" y="311" text-anchor="middle" fill="#ffba08" font-size="10" font-weight="bold">1.7M</text>
            <text x="235" y="335" text-anchor="middle" fill="#9d0208" font-size="10" font-weight="bold" opacity="0" class="percentage-label dark:fill-white">24.0%</text>
          </g>
          
          <!-- Brasil (732K) -->
          <g class="country-node cursor-pointer" data-country="Brasil" data-count="732272">
            <circle cx="320" cy="315" r="16" fill="url(#grad-brasil)" stroke="white" stroke-width="3" class="hover-effect"/>
            <text x="320" y="311" text-anchor="middle" fill="white" font-size="8" font-weight="bold">Brasil</text>
            <text x="320" y="321" text-anchor="middle" fill="#ffba08" font-size="9" font-weight="bold">732K</text>
          </g>
          
          <!-- Chile (669K) -->
          <g class="country-node cursor-pointer" data-country="Chile" data-count="669408">
            <circle cx="245" cy="355" r="14" fill="url(#grad-chile)" stroke="white" stroke-width="3" class="hover-effect"/>
            <text x="245" y="351" text-anchor="middle" fill="white" font-size="8" font-weight="bold">Chile</text>
            <text x="245" y="360" text-anchor="middle" fill="#ffba08" font-size="9" font-weight="bold">669K</text>
          </g>
          
          <!-- Ecuador (440K) -->
          <g class="country-node cursor-pointer" data-country="Ecuador" data-count="440450">
            <circle cx="240" cy="272" r="13" fill="url(#grad-ecuador)" stroke="white" stroke-width="3" class="hover-effect"/>
            <text x="240" y="268" text-anchor="middle" fill="white" font-size="7" font-weight="bold">Ecuador</text>
            <text x="240" y="277" text-anchor="middle" fill="#ffba08" font-size="8" font-weight="bold">440K</text>
          </g>
          
          <!-- Argentina (175K) -->
          <g class="country-node cursor-pointer" data-country="Argentina" data-count="174796">
            <circle cx="270" cy="375" r="11" fill="#3d0066" stroke="white" stroke-width="2" class="hover-effect"/>
            <text x="270" y="372" text-anchor="middle" fill="white" font-size="7" font-weight="bold">Argentina</text>
            <text x="270" y="381" text-anchor="middle" fill="#ffba08" font-size="8" font-weight="bold">175K</text>
          </g>
          
          <!-- México (106K) -->
          <g class="country-node cursor-pointer" data-country="México" data-count="106015">
            <circle cx="175" cy="175" r="10" fill="#ffba08" stroke="white" stroke-width="2" class="hover-effect"/>
            <text x="175" y="172" text-anchor="middle" fill="#370617" font-size="7" font-weight="bold">México</text>
            <text x="175" y="180" text-anchor="middle" fill="#370617" font-size="8" font-weight="bold">106K</text>
          </g>
          
          <!-- USA (100K) -->
          <g class="country-node cursor-pointer" data-country="USA" data-count="100000">
            <circle cx="185" cy="155" r="9" fill="#faa307" stroke="white" stroke-width="2" class="hover-effect"/>
            <text x="185" y="152" text-anchor="middle" fill="#370617" font-size="7" font-weight="bold">USA</text>
            <text x="185" y="160" text-anchor="middle" fill="#370617" font-size="7" font-weight="bold">~100K</text>
          </g>
          
          <!-- España (~80K) -->
          <g class="country-node cursor-pointer" data-country="España" data-count="80000">
            <circle cx="420" cy="120" r="9" fill="#6a040f" stroke="white" stroke-width="2" class="hover-effect"/>
            <text x="420" y="117" text-anchor="middle" fill="white" font-size="7" font-weight="bold">España</text>
            <text x="420" y="125" text-anchor="middle" fill="#ffba08" font-size="7" font-weight="bold">~80K</text>
          </g>
        </g>
        
        <!-- Mini gráfico de torta en esquina -->
        <g transform="translate(680, 40)">
          <text x="50" y="-10" text-anchor="middle" fill="#64748b" font-size="10" font-weight="bold" class="dark:fill-gray-400">Distribución</text>
          <!-- Círculo base -->
          <circle cx="50" cy="50" r="35" fill="none" stroke="#e2e8f0" stroke-width="1" class="dark:stroke-gray-700"/>
          <!-- Porciones -->
          <circle cx="50" cy="50" r="30" fill="none" stroke="url(#grad-colombia)" stroke-width="12" 
                  stroke-dasharray="77 113" stroke-dashoffset="0" transform="rotate(-90 50 50)"/>
          <circle cx="50" cy="50" r="30" fill="none" stroke="url(#grad-peru)" stroke-width="12" 
                  stroke-dasharray="45 145" stroke-dashoffset="-77" transform="rotate(-90 50 50)"/>
          <circle cx="50" cy="50" r="30" fill="none" stroke="url(#grad-brasil)" stroke-width="12" 
                  stroke-dasharray="20 170" stroke-dashoffset="-122" transform="rotate(-90 50 50)"/>
          <circle cx="50" cy="50" r="30" fill="none" stroke="#e2e8f0" stroke-width="12" 
                  stroke-dasharray="78 112" stroke-dashoffset="-142" transform="rotate(-90 50 50)" class="dark:stroke-gray-600"/>
