---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import AnimatedCard from '../components/AnimatedCard.astro';
import SignatureFooter from '../components/SignatureFooter.astro';
import MigrationDashboard from '../components/MigrationDashboard.astro';
import TradeDashboard from '../components/TradeDashboard.astro';
import { getCollection } from 'astro:content';

const baseUrl = import.meta.env.BASE_URL || '/';
const pasantiasEntries = await getCollection('pasantias');

const stats = [
  { value: "13", label: "Estudiantes", delay: 0 },
  { value: "13", label: "Años de Análisis", delay: 100 },
  { value: "3", label: "Dimensiones", delay: 200 }
];

const dimensiones = [
  {
    title: "Balanza Comercial",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>`,
    items: ["Importaciones/exportaciones", "Análisis sectorial CIIU/HS", "Evolución mensual/trimestral", "Diversificación de productos"],
    delay: 0
  },
  {
    title: "Flujos Migratorios",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>`,
    items: ["Estadísticas entradas/salidas", "Caracterización poblacional", "Políticas migratorias", "Impacto laboral"],
    delay: 100
  },
  {
    title: "Marco Normativo",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/></svg>`,
    items: ["Acuerdos comerciales", "Decretos presidenciales", "Tratados de inversión", "Decisiones CAN/ALADI"],
    delay: 200
  }
];

const hitos = [
  { date: '19 ago 2015', title: 'Cierre de frontera', desc: 'Estado de excepción en Táchira - Colapso comercial formal' },
  { date: '23 feb 2019', title: 'Ruptura diplomática total', desc: 'Reconocimiento Guaidó - Cierre de embajadas' },
  { date: '7 ago 2022', title: 'Reapertura oficial', desc: 'Gobierno Petro - Recuperación gradual de relaciones' },
  { date: '26 sep 2022', title: 'Apertura comercial total', desc: 'Normalización del comercio bilateral' }
];

const calificaciones = [
  { range: "88-100", label: "Excelente", color: "green", desc: "Sin correcciones" },
  { range: "68-88", label: "Bueno", color: "blue", desc: "Correcciones menores" },
  { range: "60-67", label: "Aceptable", color: "yellow", desc: "Correcciones moderadas" }
];
---

<Layout title="Pasantías en Investigación | Wister Márquez">
  
  <PageHeader
    badge="Experiencia Profesional"
    title="Pasantías en Investigación"
    description="Coordinación de proyectos de investigación económica y desarrollo de sistemas de estandarización académica"
  />

  <!-- Proyecto VENCOLECO -->
  <section class="py-20 bg-white dark:bg-gray-900 transition-colors duration-300">
    <div class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto">
        
        <!-- Header con icono -->
        <div class="text-center mb-12" data-aos="fade-up">
          <div class="inline-flex items-center justify-center w-20 h-20 bg-gradient-to-br from-[#6a040f] to-[#9d0208] rounded-2xl shadow-xl mb-6">
            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
          </div>
          <h2 class="text-4xl font-display font-bold text-[#6a040f] dark:text-[#ffba08] mb-4">
            Proyecto VENCOLECO
          </h2>
          <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
            <strong class="text-[#6a040f] dark:text-[#ffba08]">Venezuela-Colombia Economic Dynamics</strong> — Investigación sobre la dinámica de la economía internacional entre Venezuela y Colombia (2013-2025).
          </p>
        </div>
        
        <!-- Stats destacados -->
        <div class="grid md:grid-cols-3 gap-6 mb-12">
          {stats.map((stat) => (
            <div 
              class="bg-gradient-to-br from-white to-gray-50 dark:from-gray-800 dark:to-gray-900 p-6 rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 border border-gray-100 dark:border-gray-700"
              data-aos="zoom-in"
              data-aos-delay={stat.delay}
            >
              <div class="text-4xl font-bold bg-gradient-to-r from-[#6a040f] to-[#ffba08] bg-clip-text text-transparent mb-2">{stat.value}</div>
              <p class="text-gray-600 dark:text-gray-400 font-medium">{stat.label}</p>
            </div>
          ))}
        </div>

        <!-- Dimensiones de Investigación -->
        <h3 class="text-2xl font-display font-bold text-[#6a040f] dark:text-[#ffba08] mb-8 text-center" data-aos="fade-up">
          Dimensiones del Proyecto
        </h3>
        
        <div class="grid md:grid-cols-3 gap-6 mb-12">
          {dimensiones.map((dim) => (
            <AnimatedCard delay={dim.delay}>
              <div class="p-6 group hover:bg-gradient-to-br hover:from-[#6a040f]/5 hover:to-transparent transition-all duration-500">
                <div class="w-14 h-14 bg-gradient-to-br from-[#6a040f] to-[#9d0208] rounded-xl flex items-center justify-center mb-4 shadow-lg group-hover:scale-110 group-hover:rotate-3 transition-all duration-300">
                  <div class="text-white" set:html={dim.icon} />
                </div>
                <h4 class="font-bold text-gray-900 dark:text-white mb-2 group-hover:text-[#6a040f] dark:group-hover:text-[#ffba08] transition-colors">{dim.title}</h4>
                <ul class="text-gray-600 dark:text-gray-300 text-sm space-y-1">
                  {dim.items.map((item) => (
                    <li class="flex items-start gap-2">
                      <span class="w-1.5 h-1.5 bg-[#ffba08] rounded-full mt-1.5 flex-shrink-0"></span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </AnimatedCard>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- Crisis Migratoria Venezolana -->
  <section class="py-20 bg-gradient-to-b from-gray-50 via-white to-gray-50 dark:from-gray-800 dark:via-gray-900 dark:to-gray-800 transition-colors duration-300 overflow-hidden">
    <div class="container mx-auto px-6">
      <div class="max-w-6xl mx-auto">
        
        <!-- Header elegante -->
        <div class="text-center mb-16" data-aos="fade-up">
          <div class="inline-flex items-center justify-center w-20 h-20 bg-gradient-to-br from-[#6a040f] via-[#9d0208] to-[#d00000] rounded-2xl shadow-2xl mb-6 transform hover:scale-105 transition-transform duration-500">
            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h2 class="text-4xl font-display font-bold text-[#6a040f] dark:text-[#ffba08] mb-4">
            Crisis Migratoria Venezolana
          </h2>
          <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
            Análisis de la mayor crisis de desplazamiento en la historia reciente de América Latina
          </p>
        </div>
        
        <!-- Stats con diseño flotante y animaciones mejoradas -->
        <div class="grid md:grid-cols-3 gap-8 mb-16">
          <div 
            class="relative bg-white dark:bg-gray-800 p-8 rounded-3xl shadow-xl hover:shadow-2xl transition-all duration-500 hover:-translate-y-3 group cursor-pointer border-2 border-transparent hover:border-[#6a040f]/30 dark:hover:border-[#ffba08]/30"
            data-aos="fade-up" 
            data-aos-delay="0"
          >
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 w-8 h-8 bg-gradient-to-br from-[#6a040f] to-[#9d0208] rounded-full flex items-center justify-center shadow-lg group-hover:scale-125 transition-transform duration-300">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div class="text-center pt-4">
              <div class="text-5xl font-bold bg-gradient-to-r from-[#6a040f] to-[#d00000] bg-clip-text text-transparent mb-2 group-hover:scale-110 transition-transform duration-300 inline-block">6.9M</div>
              <p class="text-gray-600 dark:text-gray-400 font-medium">Migrantes en ALC</p>
              <span class="text-xs text-[#ffba08] font-semibold block mt-2 opacity-0 group-hover:opacity-100 transition-opacity">6.9 millones de personas</span>
            </div>
            <div class="absolute inset-0 rounded-3xl bg-gradient-to-r from-[#6a040f]/0 via-[#6a040f]/0 to-[#ffba08]/0 group-hover:from-[#6a040f]/10 group-hover:via-[#ffba08]/5 group-hover:to-[#6a040f]/10 transition-all duration-500 -z-10 blur-xl"></div>
          </div>
          
          <div 
            class="relative bg-white dark:bg-gray-800 p-8 rounded-3xl shadow-xl hover:shadow-2xl transition-all duration-500 hover:-translate-y-3 group cursor-pointer border-2 border-transparent hover:border-[#9d0208]/30 dark:hover:border-[#ffba08]/30"
            data-aos="fade-up" 
            data-aos-delay="150"
          >
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 w-8 h-8 bg-gradient-to-br from-[#9d0208] to-[#d00000] rounded-full flex items-center justify-center shadow-lg group-hover:scale-125 transition-transform duration-300">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div class="text-center pt-4">
              <div class="text-5xl font-bold bg-gradient-to-r from-[#9d0208] to-[#d00000] bg-clip-text text-transparent mb-2 group-hover:scale-110 transition-transform duration-300 inline-block">2.8M</div>
              <p class="text-gray-600 dark:text-gray-400 font-medium">En Colombia</p>
              <span class="text-xs text-[#ffba08] font-semibold block mt-2 opacity-0 group-hover:opacity-100 transition-opacity">2.8 millones - 40.9% del total</span>
            </div>
            <div class="absolute inset-0 rounded-3xl bg-gradient-to-r from-[#9d0208]/0 via-[#ffba08]/0 to-[#9d0208]/0 group-hover:from-[#9d0208]/10 group-hover:via-[#ffba08]/5 group-hover:to-[#9d0208]/10 transition-all duration-500 -z-10 blur-xl"></div>
          </div>
          
          <div 
            class="relative bg-white dark:bg-gray-800 p-8 rounded-3xl shadow-xl hover:shadow-2xl transition-all duration-500 hover:-translate-y-3 group cursor-pointer border-2 border-transparent hover:border-[#ffba08]/30 dark:hover:border-[#ffba08]/50"
            data-aos="fade-up" 
            data-aos-delay="300"
          >
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 w-8 h-8 bg-gradient-to-br from-[#ffba08] to-[#f48c06] rounded-full flex items-center justify-center shadow-lg group-hover:scale-125 transition-transform duration-300">
              <svg class="w-4 h-4 text-[#370617]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div class="text-center pt-4">
              <div class="text-5xl font-bold bg-gradient-to-r from-[#ffba08] to-[#f48c06] bg-clip-text text-transparent mb-2 group-hover:scale-110 transition-transform duration-300 inline-block">17</div>
              <p class="text-gray-600 dark:text-gray-400 font-medium">Países R4V</p>
              <span class="text-xs text-[#ffba08] font-semibold block mt-2 opacity-0 group-hover:opacity-100 transition-opacity">Plataforma ACNUR/OIM</span>
            </div>
            <div class="absolute inset-0 rounded-3xl bg-gradient-to-r from-[#ffba08]/0 via-[#6a040f]/0 to-[#ffba08]/0 group-hover:from-[#ffba08]/10 group-hover:via-[#6a040f]/5 group-hover:to-[#ffba08]/10 transition-all duration-500 -z-10 blur-xl"></div>
          </div>
        </div>

        <!-- Dashboard sin contenedor pesado -->
        <div data-aos="fade-up" data-aos-delay="400">
          <MigrationDashboard />
        </div>
        
      </div>
    </div>
  </section>

  <!-- Comercio Bilateral Colombia - Venezuela -->
  <section class="py-20 bg-white dark:bg-gray-900 transition-colors duration-300 overflow-hidden">
    <div class="container mx-auto px-6">
      <div class="max-w-6xl mx-auto">
        
        <!-- Header elegante -->
        <div class="text-center mb-16" data-aos="fade-up">
          <div class="inline-flex items-center justify-center w-20 h-20 bg-gradient-to-br from-[#6a040f] to-[#ffba08] rounded-2xl shadow-2xl mb-6 transform hover:scale-105 transition-transform duration-500">
            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
            </svg>
          </div>
          <h2 class="text-4xl font-display font-bold text-[#6a040f] dark:text-[#ffba08] mb-4">
            Comercio Bilateral Colombia - Venezuela
          </h2>
          <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
            Recuperación del intercambio comercial tras la reapertura fronteriza en agosto 2022
          </p>
        </div>
        
        <!-- Stats con diseño flotante -->
        <div class="grid md:grid-cols-4 gap-6 mb-16">
          <div 
            class="relative bg-gradient-to-br from-[#6a040f] to-[#9d0208] p-6 rounded-2xl shadow-xl hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 group text-white"
            data-aos="zoom-in" 
            data-aos-delay="0"
          >
            <div class="text-3xl font-bold mb-1">$1,137M</div>
            <p class="text-white/80 text-sm mb-2">Comercio Total 2024</p>
            <span class="inline-block px-2 py-1 bg-white/20 rounded text-xs font-semibold">↑ 41.5%</span>
          </div>
          
          <div 
            class="relative bg-white dark:bg-gray-800 p-6 rounded-2xl shadow-xl hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 group border-2 border-[#6a040f]/20"
            data-aos="zoom-in" 
            data-aos-delay="100"
          >
            <div class="text-3xl font-bold text-[#6a040f] dark:text-[#ffba08] mb-1">$1,003M</div>
            <p class="text-gray-600 dark:text-gray-400 text-sm mb-2">Exportaciones COL→VEN</p>
            <span class="inline-block px-2 py-1 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 rounded text-xs font-semibold">↑ 49.1%</span>
          </div>
          
          <div 
            class="relative bg-white dark:bg-gray-800 p-6 rounded-2xl shadow-xl hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 group border-2 border-[#ffba08]/20"
            data-aos="zoom-in" 
            data-aos-delay="200"
          >
            <div class="text-3xl font-bold text-[#6a040f] dark:text-[#ffba08] mb-1">$134M</div>
            <p class="text-gray-600 dark:text-gray-400 text-sm mb-2">Importaciones VEN→COL</p>
            <span class="inline-block px-2 py-1 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 rounded text-xs font-semibold">↑ 2.5%</span>
          </div>
          
          <div 
            class="relative bg-gradient-to-br from-[#ffba08] to-[#f48c06] p-6 rounded-2xl shadow-xl hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 group"
            data-aos="zoom-in" 
            data-aos-delay="300"
          >
            <div class="text-3xl font-bold text-[#370617] mb-1">88%</div>
            <p class="text-[#370617]/80 text-sm mb-2">Balanza favorable</p>
            <span class="inline-block px-2 py-1 bg-[#370617]/20 text-[#370617] rounded text-xs font-semibold">Superávit $869M</span>
          </div>
        </div>

        <!-- Dashboard sin contenedor pesado -->
        <div data-aos="fade-up" data-aos-delay="400">
          <TradeDashboard />
        </div>
        
      </div>
    </div>
  </section>

  <!-- Documentación del Proyecto -->
  <section class="py-20 bg-gradient-to-b from-gray-50 to-white dark:from-gray-800 dark:to-gray-900 transition-colors duration-300">
    <div class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto">
        
        <!-- Header con icono -->
        <div class="text-center mb-12" data-aos="fade-up">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-[#6a040f] to-[#9d0208] rounded-xl shadow-lg mb-4">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <h3 class="text-3xl font-display font-bold text-[#6a040f] dark:text-[#ffba08] mb-4">
            Documentación del Proyecto
          </h3>
          <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
            Manuales, planes de trabajo y recursos metodológicos desarrollados para el proyecto VENCOLECO
          </p>
        </div>

        <div class="space-y-6">
          {pasantiasEntries.map((entry, index) => (
            <AnimatedCard delay={index * 100}>
              <a href={`${baseUrl}pasantias/${entry.slug}`} class="block group">
                <div class="flex items-start justify-between p-6 bg-white dark:bg-gray-800 rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 border border-gray-100 dark:border-gray-700">
                  <div class="flex items-start gap-4">
                    <!-- Icono del documento -->
                    <div class="w-14 h-14 bg-gradient-to-br from-[#6a040f] to-[#9d0208] rounded-xl flex items-center justify-center shadow-lg flex-shrink-0 group-hover:scale-110 group-hover:rotate-3 transition-all duration-300">
                      <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                      </svg>
                    </div>
                    
                    <div class="flex-1">
                      <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-2 group-hover:text-[#6a040f] dark:group-hover:text-[#ffba08] transition-colors">
                        {entry.data.title}
                      </h4>
                      <p class="text-gray-600 dark:text-gray-300 mb-4">{entry.data.description}</p>
                      
                      <div class="flex items-center gap-4 text-sm text-gray-500 dark:text-gray-400">
                        <span class="flex items-center gap-1 bg-gray-100 dark:bg-gray-700 px-3 py-1.5 rounded-full">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                          </svg>
                          {entry.data.date}
                        </span>
                        <span class="flex items-center gap-1 bg-gray-100 dark:bg-gray-700 px-3 py-1.5 rounded-full">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                          </svg>
                          {entry.data.readingTime}
                        </span>
                      </div>
                    </div>
                  </div>
                  
                  <svg class="w-6 h-6 text-gray-400 group-hover:text-[#6a040f] dark:group-hover:text-[#ffba08] transition-colors ml-4 flex-shrink-0 group-hover:translate-x-2 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </div>
              </a>
            </AnimatedCard>
          ))}
        </div>

        <!-- Hitos Fronterizos -->
        <div class="mt-20" data-aos="fade-up">
          <div class="text-center mb-12">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-[#6a040f] to-[#9d0208] rounded-xl shadow-lg mb-4">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <h3 class="text-3xl font-display font-bold text-[#6a040f] dark:text-[#ffba08] mb-4">
              Hitos Documentados
            </h3>
            <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
              Momentos clave en la historia de las relaciones fronterizas entre Venezuela y Colombia (2015-2022)
            </p>
          </div>

          <div class="relative">
            <!-- Línea central con gradiente -->
            <div class="absolute left-8 md:left-1/2 top-0 bottom-0 w-1 bg-gradient-to-b from-[#6a040f] via-[#ffba08] to-[#6a040f] rounded-full"></div>
            
            {hitos.map((hito, index) => (
              <div 
                class={`relative flex items-center mb-12 last:mb-0 ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}
                data-aos={index % 2 === 0 ? "fade-right" : "fade-left"}
                data-aos-delay={index * 150}
              >
                <!-- Punto en la línea -->
                <div class="absolute left-6 md:left-1/2 md:-translate-x-1/2 w-6 h-6 bg-gradient-to-br from-[#6a040f] to-[#ffba08] rounded-full border-4 border-white dark:border-gray-800 shadow-lg z-10"></div>
                
                <!-- Contenido -->
                <div class={`ml-20 md:ml-0 ${index % 2 === 0 ? 'md:pr-12 md:text-right md:w-1/2' : 'md:pl-12 md:w-1/2'}`}>
                  <div class="bg-white dark:bg-gray-800 p-6 rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-500 hover:-translate-y-1 group border border-gray-100 dark:border-gray-700">
                    <span class="inline-block px-4 py-1.5 bg-gradient-to-r from-[#6a040f] to-[#9d0208] text-white text-sm font-semibold rounded-full mb-3 shadow-md">{hito.date}</span>
                    <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-2 group-hover:text-[#6a040f] dark:group-hover:text-[#ffba08] transition-colors">{hito.title}</h4>
                    <p class="text-gray-600 dark:text-gray-300">{hito.desc}</p>
                  </div>
                </div>
                
                <!-- Espacio vacío para el otro lado -->
                <div class="hidden md:block md:w-1/2"></div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>
  
  <!-- Sistema de Control de Calidad -->
  <section class="py-20 bg-white dark:bg-gray-900 transition-colors duration-300">
    <div class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto">
        
        <!-- Header con icono -->
        <div class="text-center mb-12" data-aos="fade-up">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-[#6a040f] to-[#9d0208] rounded-xl shadow-lg mb-4">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="text-3xl font-display font-bold text-[#6a040f] dark:text-[#ffba08] mb-4">
            Sistema de Control de Calidad
          </h3>
        </div>
        
        <div class="grid md:grid-cols-2 gap-8">
          <AnimatedCard delay={0}>
            <div class="p-8 group hover:bg-gradient-to-br hover:from-[#6a040f]/5 hover:to-transparent transition-all duration-500">
              <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 bg-gradient-to-br from-[#6a040f] to-[#9d0208] rounded-lg flex items-center justify-center shadow-md">
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                </div>
                <h4 class="font-bold text-gray-900 dark:text-white text-lg">Estructura de Supervisión</h4>
              </div>
              <ul class="space-y-3 text-gray-600 dark:text-gray-300">
                <li class="flex items-center gap-3 group/item">
                  <span class="w-2 h-2 bg-gradient-to-r from-[#6a040f] to-[#ffba08] rounded-full group-hover/item:scale-150 transition-transform"></span>
                  <strong class="text-[#6a040f] dark:text-[#ffba08]">4 grupos</strong> según complejidad
                </li>
                <li class="flex items-center gap-3 group/item">
                  <span class="w-2 h-2 bg-gradient-to-r from-[#6a040f] to-[#ffba08] rounded-full group-hover/item:scale-150 transition-transform"></span>
                  <strong class="text-[#6a040f] dark:text-[#ffba08]">Revisiones semanales</strong> individuales
                </li>
                <li class="flex items-center gap-3 group/item">
                  <span class="w-2 h-2 bg-gradient-to-r from-[#6a040f] to-[#ffba08] rounded-full group-hover/item:scale-150 transition-transform"></span>
                  <strong class="text-[#6a040f] dark:text-[#ffba08]">Revisiones quincenales</strong> grupales
                </li>
                <li class="flex items-center gap-3 group/item">
                  <span class="w-2 h-2 bg-gradient-to-r from-[#6a040f] to-[#ffba08] rounded-full group-hover/item:scale-150 transition-transform"></span>
                  <strong class="text-[#6a040f] dark:text-[#ffba08]">Matriz de evaluación</strong> de 100 puntos
                </li>
              </ul>
            </div>
          </AnimatedCard>

          <AnimatedCard delay={100}>
            <div class="p-8 group hover:bg-gradient-to-br hover:from-[#ffba08]/5 hover:to-transparent transition-all duration-500">
              <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 bg-gradient-to-br from-[#ffba08] to-[#f48c06] rounded-lg flex items-center justify-center shadow-md">
                  <svg class="w-5 h-5 text-[#370617]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                  </svg>
                </div>
                <h4 class="font-bold text-gray-900 dark:text-white text-lg">Escala de Calificación</h4>
              </div>
              <div class="space-y-3">
                {calificaciones.map((cal) => (
                  <div class={`flex justify-between items-center p-3 bg-${cal.color}-50 dark:bg-${cal.color}-900/20 rounded-xl transition-all hover:shadow-md group/item`}>
                    <div class="flex items-center gap-3">
                      <span class={`w-3 h-3 rounded-full bg-${cal.color}-500`}></span>
                      <span class="font-semibold text-gray-900 dark:text-white">{cal.range}</span>
                      <span class="text-sm text-gray-600 dark:text-gray-400">{cal.label}</span>
                    </div>
                    <span class={`text-xs px-2 py-1 bg-${cal.color}-100 dark:bg-${cal.color}-800 text-${cal.color}-700 dark:text-${cal.color}-300 rounded-full`}>{cal.desc}</span>
                  </div>
                ))}
              </div>
            </div>
          </AnimatedCard>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Signature Footer -->
  <section class="py-12 bg-gradient-to-b from-white to-gray-50 dark:from-gray-900 dark:to-gray-800 transition-colors duration-300">
    <div class="container mx-auto px-6">
      <SignatureFooter />
    </div>
  </section>

</Layout>
